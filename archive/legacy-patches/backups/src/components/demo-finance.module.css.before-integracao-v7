.demoHeaderActions {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.exitDemo {
  min-height: 36px;
  display: inline-flex;
  align-items: center;
  padding: 0 11px;
  border: 1px solid var(--a-border);
  border-radius: 999px;
  color: var(--a-muted);
  background: var(--a-surface);
  font-size: 10px;
  font-weight: 700;
}

.demoBreadcrumbs {
  display: flex;
  gap: 7px;
  align-items: center;
  margin: -6px 0 18px;
  color: var(--a-muted);
  font-size: 10px;
}

.demoBreadcrumbs a {
  color: var(--a-gold-strong);
}

.heroKpis {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 12px;
  margin-bottom: 14px;
}

.heroKpis article,
.demoCard,
.tableCard {
  border: 1px solid var(--a-border);
  border-radius: 12px;
  color: var(--a-text);
  background: var(--a-surface);
  box-shadow: var(--a-shadow);
}

.heroKpis article {
  min-height: 124px;
  display: grid;
  align-content: center;
  gap: 7px;
  padding: 18px;
}

.heroKpis span,
.heroKpis small,
.demoCard span,
.demoCard small,
.demoCard p {
  color: var(--a-muted);
}

.heroKpis span,
.heroKpis small {
  font-size: 11px;
}

.heroKpis strong {
  color: var(--a-heading);
  font-size: clamp(1.45rem,2vw,2rem);
}

.positive { color: var(--a-success) !important; }
.negative { color: var(--a-danger) !important; }
.gold { color: var(--a-gold-strong) !important; }

.overviewGrid,
.cardGrid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 12px;
}

.splitGrid {
  display: grid;
  gap: 22px;
}

.sectionTitle {
  margin: 0 0 10px;
  color: var(--a-heading);
  font-family: Georgia,"Times New Roman",serif;
  font-size: 20px;
  font-weight: 500;
}

.demoCard {
  min-width: 0;
  padding: 18px;
}

.demoCard header {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: flex-start;
}

.demoCard header > div {
  min-width: 0;
}

.demoCard header span {
  display: block;
  margin-bottom: 5px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
}

.demoCard h2 {
  margin: 0;
  color: var(--a-heading);
  font-family: Georgia,"Times New Roman",serif;
  font-size: 20px;
  font-weight: 500;
}

.demoCard header > strong,
.demoCard header > b {
  color: var(--a-gold-strong);
  font-size: 13px;
}

.demoCard p {
  margin: 10px 0;
  font-size: 11px;
  line-height: 1.55;
}

.demoCard > b {
  color: var(--a-heading);
  font-size: 18px;
}

.demoCard code {
  color: var(--a-gold-strong);
  font-size: 10px;
}

.miniStats {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 8px;
  margin-top: 18px;
}

.miniStats div {
  display: grid;
  gap: 3px;
  padding: 12px;
  border: 1px solid var(--a-border-soft);
  border-radius: 9px;
  background: var(--a-surface-2);
  text-align: center;
}

.miniStats strong {
  color: var(--a-gold-strong);
  font-size: 20px;
}

.miniStats span {
  font-size: 9px;
}

.goalTrack {
  height: 9px;
  overflow: hidden;
  margin-top: 16px;
  border-radius: 999px;
  background: var(--a-surface-2);
}

.goalTrack i {
  height: 100%;
  display: block;
  border-radius: inherit;
  background: linear-gradient(90deg,var(--a-gold),var(--a-success));
}

.tableCard {
  overflow-x: auto;
}

.table {
  width: 100%;
  min-width: 820px;
  border-collapse: collapse;
}

.table th,
.table td {
  padding: 13px 15px;
  border-bottom: 1px solid var(--a-border-soft);
  text-align: left;
  vertical-align: middle;
}

.table th {
  color: var(--a-muted);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.table td {
  color: var(--a-text);
  font-size: 11px;
}

.table td strong {
  display: block;
  color: var(--a-heading);
}

.table td small {
  display: block;
  margin-top: 3px;
  color: var(--a-muted);
}

.paymentCard {
  overflow: hidden;
  background:
    radial-gradient(circle at 80% 20%,var(--a-gold-soft),transparent 35%),
    var(--a-surface);
}

.cardNumber {
  margin: 24px 0 18px;
  color: var(--a-heading);
  font-family: ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size: 16px;
  letter-spacing: .08em;
}

.cardMeta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.cardMeta span {
  display: grid;
  gap: 3px;
  font-size: 9px;
}

.cardMeta strong {
  color: var(--a-heading);
  font-size: 11px;
}

.demoActions {
  display: flex;
  gap: 8px;
  margin-top: 14px;
}

.demoActions button {
  min-height: 39px;
  padding: 0 14px;
  border: 1px solid var(--a-border);
  border-radius: 8px;
  color: var(--a-text);
  background: var(--a-surface-2);
  font: inherit;
  font-size: 10px;
  font-weight: 750;
}

.demoActions button:first-child {
  color: var(--a-page-bg);
  border-color: var(--a-gold);
  background: var(--a-gold-strong);
}

@media(max-width:1100px) {
  .heroKpis {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media(max-width:720px) {
  .demoHeaderActions {
    justify-content: flex-start;
  }

  .heroKpis,
  .overviewGrid,
  .cardGrid {
    grid-template-columns: 1fr;
  }

  .table {
    min-width: 720px;
  }
}


.recentTable {
  margin-top: 12px;
}

.tableTitleRow {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: center;
  padding: 16px 18px 11px;
  border-bottom: 1px solid var(--a-border-soft);
}

.tableTitleRow span {
  color: var(--a-gold);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .08em;
}

.tableTitleRow h2 {
  margin: 4px 0 0;
  color: var(--a-heading);
  font-family: Georgia,"Times New Roman",serif;
  font-size: 20px;
  font-weight: 500;
}

.tableTitleRow a,
.demoCard header a {
  color: var(--a-gold-strong);
  font-size: 10px;
  font-weight: 700;
}
