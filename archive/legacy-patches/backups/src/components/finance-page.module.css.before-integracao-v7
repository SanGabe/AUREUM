.pageHeader {
  min-height: 142px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28px;
  padding-top: 9px;
}

.eyebrow {
  margin: 0 0 9px;
  color: var(--a-gold);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .15em;
}

.pageHeader h1 {
  margin: 0;
  color: var(--a-heading);
  font-family: Georgia,"Times New Roman",serif;
  font-size: clamp(34px,4.2vw,58px);
  font-weight: 500;
  line-height: .98;
}

.pageHeader p:not(.eyebrow) {
  max-width: 760px;
  margin: 12px 0 0;
  color: var(--a-muted);
  font-size: 10px;
  line-height: 1.55;
}

.nucleusBadge {
  margin-top: 10px;
  padding: 8px 11px;
  border: 1px solid var(--a-border);
  border-radius: 999px;
  color: var(--a-gold-strong);
  background: var(--a-gold-soft);
  font-size: 8px;
  font-weight: 750;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0 0 14px;
}

.toolbarText {
  color: var(--a-muted);
  font-size: 9px;
}

.grid2,
.grid3 {
  display: grid;
  gap: 13px;
}

.grid2 { grid-template-columns: repeat(2,minmax(0,1fr)); }
.grid3 { grid-template-columns: repeat(3,minmax(0,1fr)); }

.card,
.formCard,
.tableCard {
  border: 1px solid var(--a-border);
  border-radius: 11px;
  background: rgba(4,27,55,.75);
}

.card {
  padding: 18px;
}

.card h2,
.formCard h2,
.tableCard h2 {
  margin: 0;
  color: var(--a-heading);
  font-family: Georgia,"Times New Roman",serif;
  font-size: 18px;
  font-weight: 500;
}

.card > p {
  margin: 7px 0 0;
  color: var(--a-muted);
  font-size: 9px;
  line-height: 1.5;
}

.metric {
  display: grid;
  gap: 7px;
}

.metric span {
  color: var(--a-muted);
  font-size: 8px;
}

.metric strong {
  color: var(--a-gold-strong);
  font-family: Georgia,"Times New Roman",serif;
  font-size: 25px;
  font-weight: 500;
}

.tableCard {
  overflow: hidden;
}

.tableHeader {
  padding: 17px 18px 12px;
  border-bottom: 1px solid var(--a-border);
}

.table {
  width: 100%;
  border-collapse: collapse;
}

.table th,
.table td {
  padding: 11px 14px;
  border-bottom: 1px solid var(--a-border-soft);
  text-align: left;
  vertical-align: middle;
}

.table th {
  color: var(--a-muted-2);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.table td {
  color: var(--a-text);
  font-size: 9px;
}

.table td strong {
  color: var(--a-text);
  font-weight: 650;
}

.positive { color: var(--a-success) !important; }
.negative { color: var(--a-danger) !important; }
.gold { color: var(--a-gold-strong) !important; }

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 7px;
  border: 1px solid var(--a-border);
  border-radius: 999px;
  color: var(--a-gold-strong);
  background: var(--a-gold-soft);
  font-size: 7px;
}

.empty {
  padding: 45px 20px;
  color: var(--a-muted-2);
  text-align: center;
  font-size: 10px;
}

.formCard {
  padding: 18px;
}

.formCard form {
  display: grid;
  gap: 12px;
  margin-top: 15px;
}

.formGrid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 10px;
}

.field {
  display: grid;
  gap: 6px;
  color: var(--a-muted);
  font-size: 8px;
  font-weight: 700;
}

.field input,
.field select,
.field textarea {
  min-height: 38px;
  width: 100%;
  padding: 9px 10px;
  border: 1px solid var(--a-border);
  border-radius: 8px;
  outline: none;
  color: var(--a-text);
  background: var(--a-control-bg);
  font: inherit;
}

.field textarea {
  min-height: 75px;
  resize: vertical;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: rgba(228,170,50,.55);
}

.primaryButton,
.secondaryButton,
.dangerButton {
  min-height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 13px;
  border-radius: 7px;
  cursor: pointer;
  font-size: 8px;
  font-weight: 800;
}

.primaryButton {
  border: 1px solid var(--a-gold);
  color: #06162d;
  background: linear-gradient(135deg,#f0c35d,#dca330);
}

.secondaryButton {
  border: 1px solid var(--a-border);
  color: var(--a-gold-strong);
  background: transparent;
}

.dangerButton {
  border: 1px solid rgba(255,105,105,.28);
  color: var(--a-danger);
  background: rgba(255,105,105,.04);
}

.primaryButton:disabled,
.secondaryButton:disabled,
.dangerButton:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.notice,
.success,
.error {
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 8px;
  line-height: 1.5;
}

.notice {
  border: 1px solid var(--a-border);
  color: var(--a-muted);
  background: var(--a-gold-soft);
}

.success {
  border: 1px solid rgba(63,211,159,.2);
  color: var(--a-success);
  background: rgba(63,211,159,.04);
}

.error {
  border: 1px solid rgba(255,105,105,.2);
  color: var(--a-danger);
  background: rgba(255,105,105,.04);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.approvalCard {
  display: grid;
  gap: 10px;
  padding: 14px;
  border: 1px solid var(--a-border);
  border-radius: 9px;
  background: rgba(6,29,57,.58);
}

.approvalCard header {
  display: flex;
  justify-content: space-between;
  gap: 14px;
}

.approvalCard header strong {
  color: var(--a-text);
  font-size: 10px;
}

.approvalCard header span,
.approvalCard p {
  color: var(--a-muted);
  font-size: 8px;
}

.code {
  font-family: ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color: var(--a-gold-strong);
}

@media(max-width:980px) {
  .grid2,
  .grid3,
  .formGrid {
    grid-template-columns: 1fr;
  }

  .pageHeader {
    min-height: 120px;
  }
}

@media(max-width:650px) {
  .pageHeader {
    display: grid;
  }

  .nucleusBadge {
    width: max-content;
  }

  .tableCard {
    overflow-x: auto;
  }

  .table {
    min-width: 650px;
  }
}

/* AUREUM RESPONSIVE THEME V1 */
.pageHeader h1,
.card h2,
.formCard h2,
.tableCard h2 {
  color: var(--a-heading);
}

.card,
.formCard,
.tableCard {
  border-color: var(--a-border);
  background: var(--a-surface);
  box-shadow: var(--a-shadow);
}

.field input,
.field select,
.field textarea {
  color: var(--a-text);
  background: var(--a-input);
  border-color: var(--a-border);
}

.themeSetting {
  display: grid;
  gap: 8px;
}

.themeSetting > span {
  color: var(--a-muted);
  font-size: 9px;
  font-weight: 700;
}

@media(max-width:1180px) {
  .grid3 {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media(max-width:1024px) {
  .pageHeader {
    min-height: 118px;
    padding-top: 4px;
  }

  .pageHeader h1 {
    font-size: clamp(2.15rem,8vw,3.5rem);
  }
}

@media(max-width:720px) {
  .pageHeader {
    min-height: 0;
    display: grid;
    gap: 10px;
    margin-bottom: 18px;
  }

  .nucleusBadge {
    margin: 0;
  }

  .grid2,
  .grid3,
  .formGrid {
    grid-template-columns: 1fr;
  }

  .toolbar {
    align-items: stretch;
  }

  .tableCard {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table {
    min-width: 680px;
  }

  .formCard,
  .card {
    padding: 15px;
  }

  .primaryButton,
  .secondaryButton,
  .dangerButton {
    min-height: 44px;
  }
}

@media(max-width:460px) {
  .table {
    min-width: 620px;
  }
}

