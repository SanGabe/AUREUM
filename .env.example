# Supabase — variáveis públicas usadas no navegador e no servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — segredos somente do backend. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Atualização periódica de cotações.
FREECURRENCYAPI_KEY=
FX_SYNC_SECRET=

# WhatsApp Cloud API — somente backend.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=

# Use valores aleatórios longos e diferentes para cada segredo.
WHATSAPP_LINK_TOKEN_SECRET=
IMPORT_WORKER_SECRET=

# Identity verification (opcional até a contratação do SERPRO)
# local = validação de dígitos; serpro = fonte oficial da Receita via SERPRO.
IDENTITY_PROVIDER=local
IDENTITY_REQUIRE_OFFICIAL=true

# Credenciais SERPRO somente no servidor.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# Os endpoints oficiais já estão no código. Sobrescreva somente se o SERPRO mudar o contrato.
# SERPRO_CPF_URL_TEMPLATE=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v3/cpf/{cpf}/{birthDateCompact}
# SERPRO_CNPJ_URL_TEMPLATE=https://gateway.apiserpro.serpro.gov.br/consulta-cnpj-df/v2/basica/{cnpj}

# Proteção contra abuso de consultas pagas.
IDENTITY_RATE_LIMIT_SECRET=
IDENTITY_PER_10_MINUTE_LIMIT=5
IDENTITY_DAILY_LIMIT=100
