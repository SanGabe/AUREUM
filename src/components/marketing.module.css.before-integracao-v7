.page {
  --gold:var(--a-gold); --gold-light:#f2c561; --cream:var(--a-heading); --muted:#a7b4c7;
  min-height:100vh; overflow-x:hidden; color:var(--a-text);
  background:radial-gradient(circle at 84% 5%,rgba(228,170,50,.05),transparent 30rem),
             linear-gradient(180deg,#011932 0%,#001229 50%,#000b1c 100%);
}
.header,.hero,.content,.cta,.footer { width:min(1320px,calc(100% - 64px)); margin-inline:auto; }
.header { min-height:102px; display:grid; grid-template-columns:230px 1fr 280px; gap:25px; align-items:center; }
.logo { width:210px; height:72px; display:flex; align-items:center; }
.logo img { width:100%; height:100%; object-fit:contain; }
.nav { display:flex; justify-content:center; gap:38px; font-size:14px; color:#c8d1dd; }
.nav a { position:relative; padding:12px 0; }
.nav a:hover,.nav .active { color:var(--gold-light); }
.nav .active::after { content:""; position:absolute; left:0; right:0; bottom:3px; height:1px; background:var(--gold); }
.headerActions { display:flex; justify-content:flex-end; gap:11px; }
.primarySmall,.secondarySmall,.primaryButton { display:inline-flex; align-items:center; justify-content:center; border-radius:8px; font-weight:800; }
.primarySmall,.secondarySmall { min-height:44px; padding:0 18px; font-size:13px; }
.primarySmall,.primaryButton { color:var(--a-page-bg-2); background:linear-gradient(135deg,#f3c963,#d99d2e); }
.secondarySmall { color:var(--cream); border:1px solid rgba(228,170,50,.56); }
.hero { min-height:500px; display:grid; grid-template-columns:1fr 410px; gap:70px; align-items:center; padding:58px 0 72px; }
.eyebrow { margin:0 0 14px; color:var(--gold-light); font-family:Georgia,serif; font-size:13px; font-weight:700; letter-spacing:.15em; }
.hero h1 { max-width:840px; margin:0; color:var(--cream); font-family:Georgia,serif; font-size:clamp(3.3rem,6vw,5.6rem); font-weight:500; line-height:.99; letter-spacing:-.045em; }
.heroText { max-width:760px; margin:24px 0 0; color:var(--muted); font-size:18px; line-height:1.62; }
.heroVisual { position:relative; width:380px; height:380px; display:grid; place-items:center; justify-self:end; }
.heroVisual span { position:absolute; border:1px solid var(--a-border); border-radius:50%; }
.heroVisual span:first-child { inset:15px; } .heroVisual span:nth-child(2) { inset:58px; opacity:.55; }
.heroVisual img { position:relative; z-index:2; width:250px; height:250px; object-fit:contain; }
.content { padding:0 0 52px; }
.intro { max-width:860px; margin:0 auto 30px; text-align:center; }
.intro h2,.split h2,.cta h2 { margin:0; color:var(--cream); font-family:Georgia,serif; font-weight:500; letter-spacing:-.03em; }
.intro h2 { font-size:clamp(2.2rem,4vw,3.7rem); }
.intro p { color:var(--muted); line-height:1.62; }
.cards2,.cards3,.cards4 { display:grid; gap:16px; margin:22px 0 34px; }
.cards2 { grid-template-columns:repeat(2,1fr); } .cards3 { grid-template-columns:repeat(3,1fr); } .cards4 { grid-template-columns:repeat(4,1fr); }
.card { min-height:205px; padding:27px; border:1px solid rgba(228,170,50,.24); border-radius:14px; background:linear-gradient(145deg,rgba(8,34,65,.92),rgba(3,20,42,.95)); }
.card .number { display:inline-block; margin-bottom:18px; color:var(--gold); font-family:Georgia,serif; font-size:12px; letter-spacing:.14em; }
.card h3 { margin:0 0 9px; color:var(--gold-light); font-family:Georgia,serif; font-size:22px; font-weight:500; }
.card p { margin:0; color:var(--muted); font-size:14px; line-height:1.57; }
.card ul { display:grid; gap:7px; margin:14px 0 0; padding:0; list-style:none; color:#bdc7d5; font-size:13px; }
.card li::before { content:"—"; margin-right:8px; color:var(--gold); }
.split { display:grid; grid-template-columns:.82fr 1.18fr; gap:25px; margin:36px 0; }
.splitVisual,.splitCopy { min-height:330px; border:1px solid rgba(228,170,50,.24); border-radius:15px; background:rgba(4,25,51,.76); }
.splitVisual { display:grid; place-items:center; position:relative; overflow:hidden; }
.splitVisual img { width:245px; height:245px; object-fit:contain; position:relative; z-index:2; }
.splitVisual::before { content:""; position:absolute; width:320px; height:320px; border:1px solid var(--a-border); border-radius:50%; }
.splitCopy { padding:36px; }
.split h2 { margin:3px 0 12px; font-size:clamp(2rem,3.5vw,3.1rem); line-height:1.05; }
.splitCopy>p:not(.eyebrow) { color:var(--muted); line-height:1.62; }
.checks { display:grid; gap:12px; margin-top:21px; }
.check { display:grid; grid-template-columns:27px 1fr; gap:10px; }
.check span { width:24px; height:24px; display:grid; place-items:center; border:1px solid rgba(228,170,50,.55); border-radius:50%; color:var(--gold); font-size:11px; }
.check strong { color:#dce4ed; font-size:14px; } .check p { margin:2px 0 0; color:var(--muted); font-size:13px; line-height:1.45; }
.pillarPageHero { text-align:center; padding:65px 0 35px; }
.pillarPageHero img { width:130px; height:130px; object-fit:contain; margin-bottom:10px; }
.pillarPageHero h1 { margin:0; color:var(--gold-light); font-family:Georgia,serif; font-size:clamp(3rem,7vw,5.4rem); font-weight:500; letter-spacing:.05em; }
.pillarPageHero h2 { margin:8px 0 0; color:var(--cream); font-family:Georgia,serif; font-size:clamp(1.5rem,3vw,2.25rem); font-weight:500; }
.pillarPageHero>p { max-width:740px; margin:20px auto 0; color:var(--muted); line-height:1.65; font-size:17px; }
.cta { min-height:118px; display:grid; grid-template-columns:1fr auto; gap:30px; align-items:center; margin-bottom:24px; padding:22px 30px; border:1px solid rgba(228,170,50,.48); border-radius:13px; background:#041a35; }
.cta h2 { font-size:clamp(1.6rem,3vw,2.4rem); } .cta p:not(.eyebrow) { margin:6px 0 0; color:var(--muted); }
.primaryButton { min-height:52px; gap:18px; padding:0 22px; font-size:14px; }

.footer {
  width: min(1320px, calc(100% - 64px));
  margin-inline: auto;
  padding: 0;
  border-top: 1px solid var(--a-border);
}

.footerTop {
  min-height: 188px;
  display: grid;
  grid-template-columns:
    minmax(270px,1.65fr)
    repeat(3,minmax(110px,.62fr))
    minmax(150px,.78fr);
  gap: 36px;
  align-items: start;
  padding: 34px 0 30px;
}

.footerBrand {
  display: grid;
  align-content: start;
}

.footerBrand a {
  width: 225px;
  height: 78px;
  display: block;
}

.footerBrand img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: left center;
}

.footerBrand p {
  margin: 7px 0 2px;
  color: #b1bdcc;
  font-size: 12px;
  line-height: 1.45;
}

.footerBrand > span {
  color: #6f819a;
  font-family: Georgia, serif;
  font-size: 10px;
  letter-spacing: .035em;
}

.footerColumn {
  display: grid;
  align-content: start;
  gap: 7px;
  padding-top: 16px;
  color: #899bb3;
  font-size: 11px;
}

.footerColumn strong,
.footerSocial strong {
  margin-bottom: 4px;
  color: #dce3eb;
  font-size: 11px;
  font-weight: 600;
}

.footerColumn a {
  width: fit-content;
  transition: color .16s ease;
}

.footerColumn a:hover {
  color: var(--gold-light);
}

.footerSocial {
  padding-top: 16px;
  color: #dce3eb;
  font-size: 11px;
}

.footerSocial > div {
  display: flex;
  gap: 9px;
  margin-top: 11px;
}

.footerSocial a {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(228,170,50,.3);
  border-radius: 50%;
  color: #c6cfdb;
  font-size: 11px;
  transition:
    color .16s ease,
    border-color .16s ease,
    transform .16s ease;
}

.footerSocial a:hover {
  color: var(--gold-light);
  border-color: rgba(228,170,50,.65);
  transform: translateY(-2px);
}

.footerBottom {
  min-height: 54px;
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;
  border-top: 1px solid var(--a-border-soft);
  color: #5f728d;
  font-size: 10px;
}

.footerBottom p {
  margin: 0;
}

.footerBottom > div {
  display: flex;
  gap: 20px;
}

.footerBottom span {
  white-space: nowrap;
}

@media(max-width:1000px){
  .header{grid-template-columns:1fr auto}
  .nav{display:none}
  .hero{grid-template-columns:1fr}
  .heroVisual{justify-self:center}
  .cards4,.cards3{grid-template-columns:repeat(2,1fr)}
  .split{grid-template-columns:1fr}

  .footerTop {
    grid-template-columns: 1.35fr repeat(2, .72fr);
    row-gap: 28px;
  }

  .footerBrand {
    grid-row: span 2;
  }

  .footerSocial {
    grid-column: 3;
  }
}

@media(max-width:680px){
  .header,.hero,.content,.cta,.footer{
    width:min(100% - 28px,1320px)
  }

  .header{min-height:88px}
  .logo{width:165px}
  .primarySmall{display:none}
  .hero{padding-top:35px}
  .hero h1{font-size:clamp(3rem,14vw,4.7rem)}
  .heroVisual{width:300px;height:300px}
  .heroVisual img{width:200px;height:200px}
  .cards2,.cards3,.cards4{grid-template-columns:1fr}
  .cta{grid-template-columns:1fr}

  .footerTop {
    grid-template-columns: repeat(2,1fr);
    gap: 24px 28px;
    padding-top: 28px;
  }

  .footerBrand {
    grid-column: 1 / -1;
    grid-row: auto;
  }

  .footerBrand a {
    width: 195px;
    height: 70px;
  }

  .footerSocial {
    grid-column: auto;
  }

  .footerBottom {
    min-height: 72px;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
  }
}

@media(max-width:430px){
  .footerTop {
    grid-template-columns: 1fr;
  }

  .footerBrand,
  .footerSocial {
    grid-column: auto;
  }

  .footerBottom > div {
    gap: 12px;
    flex-wrap: wrap;
  }
}
.heroVisual img[src="/brand/aureum-seal.png"] {
  border-radius: 50%;
  clip-path: circle(50%);
  object-fit: cover;
}

/* AUREUM GLOBAL UX DEMO V2 */
.page,
.shell {
  color: var(--a-text);
  background: var(--a-page-bg);
}

.header,
.card,
.cta,
.footer {
  color: var(--a-text);
}

.card,
.cta {
  border-color: var(--a-border);
  background: var(--a-surface);
  box-shadow: var(--a-shadow);
}

/* AUREUM LIGHT THEME V6 */
:global(html[data-theme="light"]) .page {
  --gold: var(--a-gold);
  --gold-light: #a66d07;
  --cream: var(--a-heading);
  --muted: var(--a-muted);

  color: var(--a-text);
  background:
    radial-gradient(
      circle at 84% 5%,
      rgba(157,104,8,.08),
      transparent 30rem
    ),
    linear-gradient(
      180deg,
      #f8f3ea 0%,
      #f3ece1 50%,
      #e9dfd0 100%
    );
}

:global(html[data-theme="light"]) .nav {
  color: #40566c;
}

:global(html[data-theme="light"]) .secondarySmall {
  color: var(--a-heading);
  border-color: rgba(157,104,8,.50);
  background: rgba(255,250,244,.92);
}

:global(html[data-theme="light"]) .hero h1,
:global(html[data-theme="light"]) .intro h2,
:global(html[data-theme="light"]) .split h2,
:global(html[data-theme="light"]) .cta h2,
:global(html[data-theme="light"]) .pillarPageHero h2 {
  color: var(--a-heading);
}

:global(html[data-theme="light"]) .heroText,
:global(html[data-theme="light"]) .intro p,
:global(html[data-theme="light"]) .card p,
:global(html[data-theme="light"]) .splitCopy > p:not(.eyebrow),
:global(html[data-theme="light"]) .check p,
:global(html[data-theme="light"]) .pillarPageHero > p,
:global(html[data-theme="light"]) .cta p:not(.eyebrow) {
  color: var(--a-muted);
}

:global(html[data-theme="light"]) .card {
  border-color: var(--a-border);
  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f1e6d7
    );
  box-shadow: 0 12px 30px rgba(57,42,18,.07);
}

:global(html[data-theme="light"]) .card h3 {
  color: var(--a-gold-strong);
}

:global(html[data-theme="light"]) .card ul,
:global(html[data-theme="light"]) .check strong {
  color: var(--a-text);
}

:global(html[data-theme="light"]) .splitVisual,
:global(html[data-theme="light"]) .splitCopy {
  border-color: var(--a-border);
  background: #fffaf4;
  box-shadow: 0 12px 30px rgba(57,42,18,.06);
}

:global(html[data-theme="light"]) .cta {
  border-color: rgba(157,104,8,.42);
  background: #fffaf4;
  box-shadow: 0 14px 34px rgba(57,42,18,.07);
}

:global(html[data-theme="light"]) .footerBrand p,
:global(html[data-theme="light"]) .footerColumn {
  color: var(--a-muted);
}

:global(html[data-theme="light"]) .footerBrand > span,
:global(html[data-theme="light"]) .footerBottom {
  color: var(--a-muted-2);
}

:global(html[data-theme="light"]) .footerColumn strong,
:global(html[data-theme="light"]) .footerSocial strong {
  color: var(--a-heading);
}

:global(html[data-theme="light"]) .footerSocial {
  color: var(--a-text);
}

:global(html[data-theme="light"]) .footerSocial a {
  color: var(--a-text);
}
