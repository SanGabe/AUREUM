:root,
html[data-theme="dark"] {
  --a-page-bg: #000e22;
  --a-page-bg-2: #00142f;
  --a-sidebar-1: #031a35;
  --a-sidebar-2: #001126;
  --a-surface: #03172f;
  --a-surface-2: #061f3e;
  --a-surface-3: #04152c;
  --a-elevated: #08213f;
  --a-input: #061a35;
  --a-control-bg: #061a35;
  --a-control-text: #edf1f6;
  --a-control-border: rgba(228,170,50,.24);
  --a-option-bg: #071d38;
  --a-option-text: #edf1f6;
  --a-selected-bg: rgba(228,170,50,.12);
  --a-brand-chip-bg: #ffffff;
  --a-text: #e7ecf4;
  --a-heading: #f5eee1;
  --a-muted: #91a3ba;
  --a-muted-2: #7a8ea7;
  --a-gold: #e4aa32;
  --a-gold-strong: #f0c15b;
  --a-gold-soft: rgba(228,170,50,.08);
  --a-border: rgba(228,170,50,.20);
  --a-border-soft: rgba(255,255,255,.08);
  --a-shadow: 0 22px 52px rgba(0,0,0,.34);
  --a-success: #55d39f;
  --a-danger: #ed7770;
  --a-overlay: rgba(0,10,25,.78);
  --a-focus: #f1c75c;
  --a-card-gradient: linear-gradient(145deg,#061f3e,#03152c);
}

html[data-theme="light"] {
  --a-page-bg: #f3ede3;
  --a-page-bg-2: #ebe2d5;
  --a-sidebar-1: #fffaf3;
  --a-sidebar-2: #f0e5d5;
  --a-surface: #fffaf4;
  --a-surface-2: #f2e7d8;
  --a-surface-3: #ffffff;
  --a-elevated: #ffffff;
  --a-input: #ffffff;
  --a-control-bg: #ffffff;
  --a-control-text: #14283f;
  --a-control-border: rgba(92,64,17,.34);
  --a-option-bg: #ffffff;
  --a-option-text: #14283f;
  --a-selected-bg: #eadbbf;
  --a-brand-chip-bg: #ffffff;
  --a-text: #283b4f;
  --a-heading: #0c243d;
  --a-muted: #52677c;
  --a-muted-2: #62778d;
  --a-gold: #9d6808;
  --a-gold-strong: #7d5003;
  --a-gold-soft: rgba(157,104,8,.11);
  --a-border: rgba(108,76,20,.28);
  --a-border-soft: rgba(14,35,58,.14);
  --a-shadow: 0 15px 38px rgba(57,42,18,.11);
  --a-success: #0d7652;
  --a-danger: #b23f3a;
  --a-overlay: rgba(238,232,222,.88);
  --a-focus: #075f9f;
  --a-card-gradient: linear-gradient(145deg,#fffdf8,#f3e9dc);
}

html[data-theme="contrast"] {
  --a-page-bg: #000000;
  --a-page-bg-2: #000000;
  --a-sidebar-1: #000000;
  --a-sidebar-2: #000000;
  --a-surface: #000000;
  --a-surface-2: #080808;
  --a-surface-3: #000000;
  --a-elevated: #000000;
  --a-input: #000000;
  --a-control-bg: #000000;
  --a-control-text: #ffffff;
  --a-control-border: #ffffff;
  --a-option-bg: #000000;
  --a-option-text: #ffffff;
  --a-selected-bg: #252000;
  --a-brand-chip-bg: #ffffff;
  --a-text: #ffffff;
  --a-heading: #ffffff;
  --a-muted: #ffffff;
  --a-muted-2: #ffffff;
  --a-gold: #ffd400;
  --a-gold-strong: #ffe765;
  --a-gold-soft: rgba(255,212,0,.16);
  --a-border: #ffffff;
  --a-border-soft: #ffffff;
  --a-shadow: none;
  --a-success: #00ff9d;
  --a-danger: #ff7b7b;
  --a-overlay: rgba(0,0,0,.92);
  --a-focus: #00e5ff;
  --a-card-gradient: #000000;
}

html {
  background: var(--a-page-bg);
  color-scheme: dark;
}

html[data-theme="light"] {
  color-scheme: light;
}

body {
  color: var(--a-text);
  background: var(--a-page-bg);
  transition: background-color 160ms ease,color 160ms ease;
}

::selection {
  color: var(--a-page-bg);
  background: var(--a-gold-strong);
}

:where(a,button,input,select,textarea,[tabindex]):focus-visible {
  outline: 3px solid var(--a-focus) !important;
  outline-offset: 3px;
}

:where(input,select,textarea) {
  color: var(--a-control-text) !important;
  border-color: var(--a-control-border) !important;
  background-color: var(--a-control-bg) !important;
}

:where(select) {
  color-scheme: inherit;
}

:where(select option,select optgroup) {
  color: var(--a-option-text);
  background: var(--a-option-bg);
}

:where(input::placeholder,textarea::placeholder) {
  color: var(--a-muted-2);
  opacity: .9;
}

html[data-theme="contrast"] :where(a) {
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}

html[data-theme="contrast"] :where(button,input,select,textarea) {
  border-width: 2px !important;
}

html[data-theme="contrast"] :where([class*="card"],[class*="Card"],[class*="panel"],[class*="Panel"]) {
  box-shadow: none !important;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

